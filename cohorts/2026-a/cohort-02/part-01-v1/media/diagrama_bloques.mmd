graph LR
    %% Definición de nodos
    A["P(A) = 0.7"]
    B["P(B) = 0.7"]
    C["P(C) = 0.8"]
    D["P(D) = 0.8"]
    E["P(E) = 0.8"]
    
    %% Nodos invisibles para unión paralela
    Start(( ))
    End(( ))

    %% Conexiones
    Start --> A --> B --> End
    Start --> C --> D --> E --> End

    %% Estilos (Opcional, para mejor visualización)
    style Start fill:#333,stroke:#333
    style End fill:#333,stroke:#333
